# Cloudflare Workers Static Assets / Pages header rules.
#
# Syntax: an unindented path pattern, then indented "Name: Value" lines.
# These apply only to static asset responses — if a Worker script is ever added here,
# it must set its own headers, because these rules do not apply to Worker output.
#
# Note on compression: there is nothing to configure. Cloudflare negotiates Brotli (or
# gzip) per request from Accept-Encoding and compresses text assets at the edge. Do NOT
# set Content-Encoding here; that would claim an encoding the body doesn't have.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # The site ships no JavaScript at all and loads nothing from another origin, so this
  # can be about as tight as a CSP gets. script-src 'none' is the load-bearing line:
  # if a script ever sneaks in, the page breaks loudly here rather than quietly
  # shipping something the privacy claims don't cover.
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# HTML is what changes; let it revalidate rather than go stale in a browser cache.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Filenames are not content-hashed, so a long max-age would strand visitors on an old
# build after a deploy. A day is enough to make repeat visits free without that risk.
/styles.css
  Cache-Control: public, max-age=86400

/icon.svg
  Cache-Control: public, max-age=86400

/icon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/social-card.jpg
  Cache-Control: public, max-age=604800
