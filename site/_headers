# Cloudflare Workers Static Assets / Pages header rules.
#
# Syntax: an unindented path pattern, then indented "Name: Value" lines.
# These apply only to static asset responses — if a Worker script is ever added here,
# it must set its own headers, because these rules do not apply to Worker output.
#
# Note on compression: there is nothing to configure. Cloudflare negotiates Brotli (or
# gzip) per request from Accept-Encoding and compresses text assets at the edge. Do NOT
# set Content-Encoding here; that would claim an encoding the body doesn't have.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # The site loads nothing from another origin, so this is about as tight as a CSP gets.
  #
  # script-src is the load-bearing line. @script-hashes@ is replaced at build time by
  # scripts/build-site.mjs with a sha256 hash of each inline script it finds in the
  # built HTML — or with 'none' when there are none. That makes script-src a whitelist
  # of exact byte sequences: no 'unsafe-inline', no 'self', and no way to load a script
  # from anywhere. Editing a script without rebuilding means the browser refuses to run
  # it, which is the failure mode we want.
  Content-Security-Policy: default-src 'none'; script-src @script-hashes@; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# HTML is what changes; let it revalidate rather than go stale in a browser cache.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Filenames are not content-hashed, so a long max-age would strand visitors on an old
# build after a deploy. A day is enough to make repeat visits free without that risk.
/styles.css
  Cache-Control: public, max-age=86400

/icon.svg
  Cache-Control: public, max-age=86400

/icon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/social-card.jpg
  Cache-Control: public, max-age=604800
